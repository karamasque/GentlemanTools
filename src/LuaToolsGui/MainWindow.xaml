<ui:FluentWindow
    x:Class="LuaToolsGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    xmlns:views="clr-namespace:LuaToolsGui.Views"
    Title="GentlemanStation"
    Icon="icon.ico"
    Width="1160"
    Height="760"
    MinWidth="820"
    MinHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BgMainBrush}"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── TitleBar ── -->
        <ui:TitleBar
            Grid.Row="0"
            Title="GentlemanStation"
            Height="40"
            Background="{DynamicResource BgSidebarBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/icon.ico" Width="18" Height="18" Margin="12,0,6,0" VerticalAlignment="Center" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                    <TextBlock
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMainBrush}"
                        VerticalAlignment="Center"
                        Text="GentlemanStation" />
                    <Border
                        Margin="10,0,0,0"
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentBgBrush}"
                        BorderBrush="{DynamicResource BorderHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AccentPrimaryBrush}"
                            Text="{Binding VersionLabel}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <!-- App content (nav rail + toasts). Blurred while the first-run welcome overlay is open. -->
            <Grid x:Name="AppContent">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Onboarding.IsOpen}" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <BlurEffect KernelType="Gaussian" Radius="28" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Fluent nav rail -->
                <ui:NavigationView
                    x:Name="RootNavigation"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleVisible="False"
                    OpenPaneLength="214"
                    PaneDisplayMode="Left"
                    Background="{DynamicResource BgSidebarBrush}">
                    
                    <!-- Main Navigation Items -->
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Home}" TargetPageType="{x:Type views:HomeView}" ToolTip="{x:Static res:Strings.Nav_Home}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Home24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Add}" TargetPageType="{x:Type views:DownloadView}" ToolTip="{x:Static res:Strings.Nav_Add}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Manage}" TargetPageType="{x:Type views:ManageView}" ToolTip="{x:Static res:Strings.Nav_Manage}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Games24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Builds}" TargetPageType="{x:Type views:BuildsView}" ToolTip="{x:Static res:Strings.Nav_Builds}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="BranchFork24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Mode}" TargetPageType="{x:Type views:ModeView}" ToolTip="{x:Static res:Strings.Nav_Mode}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Options24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Fixes}" TargetPageType="{x:Type views:FixesView}" ToolTip="{x:Static res:Strings.Nav_Fixes}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="ShieldTask24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Plugins}" TargetPageType="{x:Type views:PluginView}" ToolTip="{x:Static res:Strings.Nav_Plugins}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="PuzzlePiece24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.MenuItems>

                    <!-- Footer Navigation Items -->
                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_RestartSteam}" Click="RestartSteam_Click" ToolTip="{x:Static res:Strings.Nav_RestartSteam}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Downloads}" TargetPageType="{x:Type views:DownloadsView}" ToolTip="{x:Static res:Strings.Nav_Downloads}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                        <ui:NavigationViewItem Content="{x:Static res:Strings.Nav_Settings}" TargetPageType="{x:Type views:SettingsView}" ToolTip="{x:Static res:Strings.Nav_Settings}">
                            <ui:NavigationViewItem.Icon>
                                <ui:SymbolIcon Symbol="Settings24" />
                            </ui:NavigationViewItem.Icon>
                        </ui:NavigationViewItem>
                    </ui:NavigationView.FooterMenuItems>

                    <!-- Pane Footer: User auth & status card -->
                    <ui:NavigationView.PaneFooter>
                        <StackPanel Margin="10,6,10,10">
                            <!-- Guest Sign-in Card -->
                            <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding SignInCommand}"
                                    Style="{DynamicResource GentlemanPrimaryButton}"
                                    Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}"
                                    Padding="10,8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Margin="0,0,6,0" FontSize="14" Symbol="Person24" />
                                        <TextBlock Text="{x:Static res:Strings.Nav_SignInDiscord}" FontSize="11.5" />
                                    </StackPanel>
                                </Button>
                                
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Margin="0,4"
                                    Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                                    <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" />
                                    <TextBlock
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{x:Static res:Strings.Nav_WaitingForBrowser}" />
                                </StackPanel>
                                
                                <TextBlock
                                    Margin="2,6,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource ErrorBrush}"
                                    Text="{Binding SignInError}"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding SignInError, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>

                            <!-- User Status Pill / Info -->
                            <Border
                                Margin="0,8,0,0"
                                Padding="10,6"
                                Background="{DynamicResource SurfacePrimaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMedium}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse
                                        Grid.Column="0"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRealUser}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Text="{Binding FooterStatus}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding FooterStatus}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ui:NavigationView.PaneFooter>
                </ui:NavigationView>

                <!-- Bottom-right toasts (attached to ToastService in App.OnStartup) -->
                <ui:SnackbarPresenter
                    x:Name="RootSnackbar"
                    Margin="0,0,24,18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" />
            </Grid>

            <!-- First-run welcome overlay -->
            <views:OnboardingView
                DataContext="{Binding Onboarding}"
                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
