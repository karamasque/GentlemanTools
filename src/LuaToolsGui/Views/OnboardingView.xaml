<UserControl
    x:Class="LuaToolsGui.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:OnboardingViewModel}"
    mc:Ignorable="d">

    <!-- Dim scrim background -->
    <Grid Background="#CC07090E">
        <Border
            MaxWidth="480"
            Margin="20"
            Padding="36,40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#12151D"
            BorderBrush="#25FFFFFF"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel HorizontalAlignment="Center" Width="400">
                <!-- App Logo & Title -->
                <Border
                    Width="68"
                    Height="68"
                    CornerRadius="34"
                    Background="#1E2333"
                    BorderBrush="#38bdf8"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/icon.ico" Width="38" Height="38" Stretch="Uniform" />
                </Border>

                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="GentlemanStation" />

                <TextBlock
                    Margin="0,6,0,24"
                    FontSize="13.5"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    Foreground="#9ca3af"
                    Text="Uygulamaya erişmek ve VIP ayrıcalıklarınıza ulaşmak için lütfen Discord hesabınızla giriş yapın."
                    TextWrapping="Wrap" />

                <!-- Guest State: Discord Login -->
                <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                    <!-- Big Discord Button -->
                    <Button
                        Height="46"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        Background="#5865F2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        Command="{Binding SignInCommand}"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVis}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="White" Margin="0,0,10,0" />
                            <TextBlock Text="🎮 Discord ile Giriş Yap" FontWeight="Bold" FontSize="14" Foreground="White" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Waiting for browser -->
                    <StackPanel
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#9ca3af"
                            Text="Tarayıcıda yetkilendirme bekleniyor..." />
                    </StackPanel>

                    <!-- Error if any -->
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Foreground="#f87171"
                        Text="{Binding StatusLine}"
                        TextWrapping="Wrap"
                        Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Guest Bypass Link -->
                    <Button
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        Foreground="#6b7280"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="12.5"
                        Command="{Binding FinishCommand}"
                        Content="Giriş yapmadan devam et (Misafir)" />
                </StackPanel>

                <!-- Signed In Confirmation State -->
                <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                    <Border
                        Padding="14"
                        Background="#1A22c55e"
                        BorderBrush="#3322c55e"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" Foreground="#4ade80" Margin="0,0,8,0" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#4ade80"
                                VerticalAlignment="Center"
                                Text="Discord ile Giriş Yapıldı!" />
                        </StackPanel>
                    </Border>

                    <Button
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Background="#38bdf8"
                        Foreground="#0f172a"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        Command="{Binding FinishCommand}"
                        Content="Uygulamaya Başla 🚀">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
