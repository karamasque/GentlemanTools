<UserControl
    x:Class="LuaToolsGui.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Section card: one bordered container that groups a section's rows. -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <!-- Section header (small grey uppercase label above each card). -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,24,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9ca3af" />
        </Style>
        <!-- Thin divider between rows inside a card. -->
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="Margin" Value="14,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="{DynamicResource StandardPageMargin}">
            <TextBlock
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{x:Static res:Strings.Settings_Title}" />

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- 💎 HESAP & GENTLEMAN VIP                                       -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <TextBlock
                Margin="0,20,0,8"
                Style="{StaticResource SectionHeader}"
                Text="{x:Static res:Strings.Settings_Section_Account}" />

            <Border Padding="18" CornerRadius="12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SettingsCard}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVipActive}" Value="True">
                                <Setter Property="BorderBrush" Value="#38bdf8" />
                                <Setter Property="BorderThickness" Value="1.5" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsLifetime}" Value="True">
                                <Setter Property="Background" Value="#1E1705" />
                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                <Setter Property="BorderThickness" Value="2" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="24" ShadowDepth="0" Opacity="0.5" RenderingBias="Performance" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- Signed-in Account (Discord + VIP) -->
                    <StackPanel Visibility="{Binding IsRealUser, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="50"
                                Height="50"
                                CornerRadius="25"
                                BorderThickness="2.5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="#334155" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVipActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="#38bdf8" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLifetime}" Value="True">
                                                <Setter Property="BorderBrush" Value="#FDE047" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FBBF24" BlurRadius="12" ShadowDepth="0" Opacity="0.7" RenderingBias="Performance" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="15.5"
                                        FontWeight="Bold"
                                        Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLifetime}" Value="True">
                                                        <Setter Property="Foreground" Value="#FEF08A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- VIP Badge -->
                                    <Border
                                        Margin="10,0,0,0"
                                        Padding="9,2.5"
                                        CornerRadius="12"
                                        Visibility="{Binding IsVipActive, Converter={StaticResource BoolToVis}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2538bdf8" />
                                                <Setter Property="BorderBrush" Value="#38bdf8" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLifetime}" Value="True">
                                                        <Setter Property="Background" Value="#4DEAB308" />
                                                        <Setter Property="BorderBrush" Value="#FDE047" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#F59E0B" BlurRadius="14" ShadowDepth="0" Opacity="0.65" RenderingBias="Performance" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Text="{Binding VipBadgeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#38bdf8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLifetime}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFFBEB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#9ca3af"
                                    Text="{Binding Email}" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    Text="{Binding VipStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#38bdf8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLifetime}" Value="True">
                                                    <Setter Property="Foreground" Value="#FCD34D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <ui:Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding SignOutCommand}"
                                Content="{x:Static res:Strings.Settings_SignOut}"
                                Icon="{ui:SymbolIcon SignOut24}" />
                        </Grid>

                        <!-- Redeem License Key Box -->
                        <Border Style="{StaticResource RowDivider}" Margin="0,16,0,16" />
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="🔑 Lisans Anahtarı Kullan (VIP Aktifleştir)" />
                        <TextBlock
                            Margin="0,2,0,8"
                            FontSize="12"
                            Foreground="#9ca3af"
                            Text="Satın aldığınız veya hediye edilen VIP lisans kodunu girerek hesabınıza tanımlayın." />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                CharacterCasing="Upper"
                                PlaceholderText="XXXX-XXXX-XXXX-XXXX"
                                Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding RedeemLicenseKeyCommand}"
                                Content="Kodu Kullan"
                                Icon="{ui:SymbolIcon Key24}" />
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#4ade80"
                            Text="{Binding LicenseRedeemMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding LicenseRedeemMessage, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <!-- Guest State (Discord Login) -->
                    <StackPanel Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
                        <!-- Login-required banner: shown when redirected from a protected action. -->
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            Background="#1A3b82f6"
                            BorderBrush="#333b82f6"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding LoginRequiredMessage, Converter={StaticResource NullToCollapsed}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon
                                        Margin="0,0,8,0"
                                        FontSize="16"
                                        Foreground="#60a5fa"
                                        Symbol="Info24" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="{Binding LoginRequiredMessage}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Appearance="Secondary"
                                    Command="{Binding DismissLoginRequiredCommand}"
                                    Content="✕" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="GentlemanStation Hesabı" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#9ca3af"
                                    Text="VIP özelliklerinizi kullanmak ve kütüphanenizi yönetmek için Discord ile giriş yapın." />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="1"
                                Appearance="Primary"
                                Command="{Binding SignInCommand}"
                                Content="🎮 Discord ile Giriş Yap" />
                        </Grid>

                        <!-- Discord bot code: redeem a /login code without the browser flow. -->
                        <Border Style="{StaticResource RowDivider}" Margin="0,14,0,14" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#9ca3af"
                            Text="{x:Static res:Strings.Settings_BotCode_Hint}" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:TextBox
                                Width="120"
                                CharacterCasing="Upper"
                                MaxLength="6"
                                PlaceholderText="{x:Static res:Strings.Settings_BotCode_Placeholder}"
                                Text="{Binding CodeInput, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding SignInWithCodeCommand}"
                                Content="{x:Static res:Strings.Settings_BotCode_Redeem}"
                                Icon="{ui:SymbolIcon Link24}"
                                IsEnabled="{Binding CanRedeemCode}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11.5"
                            Foreground="#f87171"
                            Text="{Binding CodeError}"
                            TextWrapping="Wrap"
                            Visibility="{Binding CodeError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Hubcap API key -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Hubcap}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <!-- Active key: stats card -->
                    <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource BoolToVis}}">
                        <!-- Active badge + Refresh -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button
                                HorizontalAlignment="Left"
                                Appearance="Secondary"
                                Command="{Binding RefreshHubcapStatsCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapRefresh}"
                                Icon="{ui:SymbolIcon ArrowSync24}" />
                            <ui:Button
                                Grid.Column="1"
                                Command="{Binding ClearHubcapKeyCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapClear}"
                                Icon="{ui:SymbolIcon Dismiss24}" />
                        </Grid>
                        <!-- Usage progress card -->
                        <Border Margin="0,0,0,10" Padding="12" Background="#08FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="6"
                                Visibility="{Binding ShowHubcapStats, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <!-- Real ProgressBar (Fluent-styled, same as PluginView/ModeView/FixesView).
                                     HubcapUsagePercent is 0.0–1.0, so Maximum="1"; ProgressBar clamps past it.
                                     Indeterminate (animated) until stats load, so the card is never blank. -->
                                <ProgressBar
                                    Height="6"
                                    IsIndeterminate="{Binding HubcapStatsPending}"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="{Binding HubcapUsagePercent, Mode=OneWay}" />
                                <TextBlock Margin="0,8,0,0" FontSize="13"
                                           Text="{Binding HubcapStatsText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Key input: only while NO key is saved. Once configured, the Refresh/Clear buttons +
                         usage card above are the whole story; "Clear" is how you swap keys (it resets
                         HubcapIsKeyConfigured, bringing this block back). The onboarding copy below reads
                         wrong when a key already exists, hence the collapse. -->
                    <StackPanel Visibility="{Binding HubcapIsKeyConfigured, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{x:Static res:Strings.Settings_HubcapKey}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="#6b7280"
                            Text="{x:Static res:Strings.Settings_HubcapKey_Hint}"
                            TextWrapping="Wrap" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox
                                FontFamily="Consolas"
                                PlaceholderText="{x:Static res:Strings.Settings_HubcapKeyPlaceholder}"
                                Text="{Binding HubcapKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding ValidateAndSaveHubcapKeyCommand}"
                                Content="{x:Static res:Strings.Settings_HubcapValidate}"
                                IsEnabled="{Binding CanEditHubcapKey}" />
                        </Grid>
                        <!-- Error text (only ever set by the two ValidateAndSaveHubcapKeyAsync failure paths,
                             so it can never be orphaned by this collapse). -->
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{Binding HubcapKeyStatusColor}"
                            Text="{Binding HubcapKeyStatus}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HubcapKeyStatus, Converter={StaticResource NullToCollapsed}}" />
                        <!-- "Get a key" link -->
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="#6b7280">
                            <Run Text="{x:Static res:Strings.Settings_HubcapGetKey}" />
                            <Hyperlink Command="{Binding OpenHubcapCommand}" Foreground="#a78bfa">hubcapmanifest.com</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Install behavior (Auto Update Apps + FastFetch) -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Install}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Auto Update Apps -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Settings_AutoUpdateApps_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding AutoUpdateApps, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- FastFetch (same persisted setting as the Add screen's toggle) -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Add_FastFetch}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Add_FastFetch_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding FastFetch, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- General (language) -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_General}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Static res:Strings.Settings_Language}" />
                    <ComboBox
                        Margin="0,8,0,0"
                        MinWidth="220"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Display"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedItem="{Binding SelectedLanguage}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="#6b7280"
                        Text="{x:Static res:Strings.Settings_Language_Hint}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Steam -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Steam}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel Margin="14,12">
                    <TextBlock
                        FontSize="13"
                        FontWeight="Medium"
                        Text="{x:Static res:Strings.Settings_SteamLocation}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            IsReadOnly="True"
                            Text="{Binding SteamPath, Mode=OneWay}" />
                        <ui:Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding OverrideSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Change}" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding OpenSteamFolderCommand}"
                            Content="{x:Static res:Strings.Settings_Open}"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Command="{Binding ClearSteamOverrideCommand}"
                            Content="{x:Static res:Strings.Settings_ResetToAuto}"
                            Visibility="{Binding IsSteamOverridden, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="12"
                        Foreground="#6b7280"
                        Text="{Binding SteamSource}" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#f87171"
                        Text="{Binding SteamWarning}"
                        TextWrapping="Wrap"
                        Visibility="{Binding SteamWarning, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Startup}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <!-- Start with Windows -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_StartWithWindows}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Settings_StartWithWindows_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <!-- Minimize to System Tray -->
                    <Grid Margin="14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="#6b7280"
                                Text="{x:Static res:Strings.Settings_MinimizeToTray_Hint}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Community -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="{x:Static res:Strings.Settings_Section_Community}" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Medium"
                            Text="{x:Static res:Strings.Settings_DonateKeys}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="#6b7280"
                            Text="{x:Static res:Strings.Settings_DonateKeys_Hint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding DonateKeys, Mode=TwoWay}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
