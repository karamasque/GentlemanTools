<UserControl
    x:Class="LuaToolsGui.Views.DropZone"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DropInstallViewModel}"
    AllowDrop="True"
    DragEnter="OnDragEnter"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">

    <Grid>
        <!-- The drop box container -->
        <Border
            MinHeight="120"
            Padding="24,20"
            Background="{DynamicResource SurfacePrimaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1.5"
            CornerRadius="{DynamicResource RadiusCard}"
            SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentBgBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <!-- Dashed inner guide -->
                <Rectangle
                    Stroke="{DynamicResource BorderSubtleBrush}"
                    StrokeDashArray="4 4"
                    StrokeThickness="1"
                    RadiusX="10"
                    RadiusY="10"
                    SnapsToDevicePixels="True" />

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="16,12">
                    
                    <!-- Icon badge -->
                    <Border
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource AccentBgBrush}"
                        BorderBrush="{DynamicResource BorderHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="22">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="{DynamicResource AccentPrimaryBrush}"
                            Symbol="ArrowUpload24" />
                    </Border>

                    <!-- Text guidance -->
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMainBrush}"
                        Text="{x:Static res:Strings.Drop_Title}" />

                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="{x:Static res:Strings.Drop_LinkHint}" />

                    <!-- Action buttons row -->
                    <StackPanel
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Click="OnBrowseClick"
                            Style="{DynamicResource GentlemanSecondaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource AccentSecondaryBrush}"
                                    Symbol="FolderOpen24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Static res:Strings.Drop_BrowseFiles}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Result banner -->
                    <Border
                        Margin="0,10,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Center"
                        CornerRadius="{DynamicResource RadiusSmall}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultFailed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontSize="12"
                            FontWeight="Medium"
                            Text="{Binding ResultText}"
                            TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
