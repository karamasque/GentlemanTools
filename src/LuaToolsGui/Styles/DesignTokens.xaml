<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Colors & Solid Color Brushes ── -->
    <!-- Backgrounds -->
    <Color x:Key="ColorBgMain">#0D1117</Color>
    <Color x:Key="ColorBgSidebar">#12161F</Color>
    <SolidColorBrush x:Key="BgMainBrush" Color="{StaticResource ColorBgMain}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource ColorBgSidebar}" />

    <!-- Surfaces -->
    <Color x:Key="ColorSurfacePrimary">#161B26</Color>
    <Color x:Key="ColorSurfaceSecondary">#1C2331</Color>
    <Color x:Key="ColorSurfaceHover">#232B3C</Color>
    <Color x:Key="ColorSurfaceActive">#2A3449</Color>
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource ColorSurfacePrimary}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource ColorSurfaceSecondary}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource ColorSurfaceActive}" />

    <!-- Borders -->
    <Color x:Key="ColorBorderSubtle">#1AFFFFFF</Color> <!-- rgba(255,255,255, 0.10) -->
    <Color x:Key="ColorBorderHighlight">#337C6CF2</Color>
    <Color x:Key="ColorBorderActive">#777C6CF2</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource ColorBorderHighlight}" />
    <SolidColorBrush x:Key="BorderActiveBrush" Color="{StaticResource ColorBorderActive}" />

    <!-- Typography (Enhanced Contrast) -->
    <Color x:Key="ColorTextMain">#F5F7FA</Color>
    <Color x:Key="ColorTextSecondary">#B0BAC9</Color> <!-- +20% more visible than old #9CA8BA -->
    <Color x:Key="ColorTextMuted">#7B889B</Color>     <!-- +25% more visible than old #697586 -->
    <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource ColorTextMain}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}" />

    <!-- Accent & Status Colors -->
    <Color x:Key="ColorAccentPrimary">#7C6CF2</Color>
    <Color x:Key="ColorAccentSecondary">#4AA8FF</Color>
    <Color x:Key="ColorSuccess">#35D49A</Color>
    <Color x:Key="ColorWarning">#F2B84B</Color>
    <Color x:Key="ColorError">#FF5E78</Color>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}" />

    <!-- Subtle Status Tint Backgrounds -->
    <SolidColorBrush x:Key="AccentBgBrush" Color="#227C6CF2" />
    <SolidColorBrush x:Key="SuccessBgBrush" Color="#2235D49A" />
    <SolidColorBrush x:Key="WarningBgBrush" Color="#22F2B84B" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#22FF5E78" />

    <!-- ── Gradients ── -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#7C6CF2" />
        <GradientStop Offset="1" Color="#4AA8FF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroCardGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#1C2331" />
        <GradientStop Offset="1" Color="#141923" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GameCoverOverlayGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.3" Color="#00000000" />
        <GradientStop Offset="1.0" Color="#E60D1117" />
    </LinearGradientBrush>

    <!-- ── Dimensions & Corner Radii ── -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">18</CornerRadius>
    <CornerRadius x:Key="RadiusPill">24</CornerRadius>

    <!-- ── Standard Page Margin / Padding ── -->
    <Thickness x:Key="StandardPageMargin">30,24,30,24</Thickness>

</ResourceDictionary>
